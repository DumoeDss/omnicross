{
  "name": "@omnicross/chatgpt-web",
  "version": "0.4.4",
  "private": true,
  "description": "EXPERIMENTAL — ChatGPT Web (browser) as a Codex Responses backend over CDP. Not published.",
  "license": "MIT",
  "author": "Sayo (https://github.com/Dumoedss)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dumoedss/omnicross",
    "directory": "packages/chatgpt-web"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.14",
    "jsdom": "^24.1.3",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
